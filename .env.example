# Orbit env — copy to .env
PORT=6742
DATABASE_PATH=./data/orbit.sqlite
# sql.js persists to this file (SQLite-compatible). For Postgres swap set DATABASE_URL.
# DATABASE_URL=postgres://user:pass@localhost:5432/orbit
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
VITE_API_URL=http://127.0.0.1:6742
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
CORS_ORIGIN=http://localhost:5174
